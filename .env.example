# Copy this file to .env (for local dev with `vercel dev`) or add these as
# Environment Variables in your Vercel project settings for production.

# --- AI card generation (OpenAI) ---
OPENAI_API_KEY=sk-...

# --- Payments (Stripe) ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Order notification email (Resend) ---
# Sent to YOU every time someone pays, with the design image, their message,
# and shipping address, so you can print and mail the card yourself.
RESEND_API_KEY=re_...
NOTIFY_EMAIL=you@example.com
# Optional — defaults to Resend's shared address, which needs no setup.
NOTIFY_FROM_EMAIL=Cardello Orders <onboarding@resend.dev>

# --- Image storage (Vercel Blob) ---
# Enable "Blob" under your Vercel project's Storage tab and connect it to
# this project — Vercel sets this automatically, you don't need to find it
# yourself. Without it, the design image won't make it into the order email.
BLOB_READ_WRITE_TOKEN=

# --- Site ---
# Your production domain, used to build Stripe redirect URLs.
PUBLIC_SITE_URL=https://cardello.ca
